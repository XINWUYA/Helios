<rml>
<head>
	<link type="text/css" href="Joystick.rcss" />
	<title>Runtime UI</title>
</head>
<body>
	<div id="hud">
		<div id="panel">
			<div id="title">Runtime UI</div>
			<span id="fps-value">-- fps</span>
			<div id="subtitle">Drag the stick to fly the camera</div>

			<!-- 滑杆值按 name 递给脚本，右侧的数字由脚本回写 -->
			<div class="setting">
				<span class="setting-label">Speed</span>
				<input class="slider" type="range" name="move_speed" min="1" max="30" step="0.5" value="9" />
				<span class="setting-value" id="speed-value">9.0</span>
			</div>
			<div class="setting">
				<span class="setting-label">Look</span>
				<input class="slider" type="range" name="look_sensitivity" min="0.05" max="1.5" step="0.05" value="0.3" />
				<span class="setting-value" id="look-value">0.30</span>
			</div>
		</div>

		<div id="actions">
			<button id="btn-tod" class="btn">Pause TOD</button>
			<button id="btn-grass" class="btn">Hide Grass</button>
		</div>

		<!-- 圆形按钮：相机回到出生位姿 -->
		<button id="btn-camera" class="btn">Reset</button>

		<joystick name="move" id="stick">
			<knob id="knob" />
		</joystick>
	</div>
</body>
</rml>
