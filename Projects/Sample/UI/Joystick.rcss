/* 运行时 UI 的示例样式：左上角一块说明，左下角一个摇杆。
 * 单位按物理像素写，Context 的 dp-ratio 当前是 1。
 * RmlUi 没有内建的标签默认样式，display 一律显式给。 */

body
{
	display: block;
	margin: 0px;
	width: 100%;
	height: 100%;
	font-family: Open Sans;
	font-size: 16dp;
	color: #f2f4f8;
}

#hud
{
	display: block;
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	/* 整层不吃指针，摇杆单独打开：免得 HUD 挡住游戏画面的操作 */
	pointer-events: none;
}

#panel
{
	display: block;
	position: absolute;
	left: 36dp;
	top: 28dp;
	/* 定宽：绝对定位的块是收缩宽度，不带宽度时文本框会把它撑破 */
	width: 320dp;
	padding: 14dp;
	/* 整块吃指针：hud 那层是 none，这里不打开的话在面板上按下会被当成转视角 */
	pointer-events: auto;
	background-color: rgba(12, 16, 24, 140);
	border-radius: 10dp;
	border: 1dp rgba(255, 255, 255, 40);
}

#title
{
	display: block;
	font-size: 22dp;
	font-weight: bold;
}

#subtitle
{
	display: block;
	margin-top: 6dp;
	font-size: 14dp;
	color: rgba(242, 244, 248, 170);
}

/* 面板里的两行调节：速度与视角灵敏度。一行里三块都垂直居中 */
.setting
{
	display: block;
	margin-top: 10dp;
	height: 22dp;
}

.setting-label
{
	display: inline-block;
	width: 40dp;
	font-size: 13dp;
	color: rgba(242, 244, 248, 170);
	vertical-align: middle;
}

.setting-value
{
	display: inline-block;
	width: 44dp;
	font-size: 13dp;
	text-align: right;
	vertical-align: middle;
}

.slider
{
	display: inline-block;
	width: 160dp;
	height: 22dp;
	vertical-align: middle;
}

.slider slidertrack
{
	margin-top: 8dp;
	height: 6dp;
	border-radius: 3dp;
	background-color: rgba(255, 255, 255, 46);
}

/* 进度条的位置 = 轨道位置 + 它自己的 margin：给 0 才和轨道重合 */
.slider sliderprogress
{
	margin-top: 0;
	height: 6dp;
	border-radius: 3dp;
	background-color: #7f77dd;
}

.slider sliderbar
{
	margin-top: 4dp;
	width: 14dp;
	height: 14dp;
	border-radius: 7dp;
	background-color: #f2f4f8;
}

/* 面板右上角的帧率：跟标题同一行 */
#fps-value
{
	display: block;
	position: absolute;
	right: 14dp;
	top: 18dp;
	font-size: 13dp;
	color: rgba(242, 244, 248, 170);
}

/* 右下角一排按钮：点一下脚本按 id 取，用来切 TOD 与草 */
#actions
{
	display: flex;
	position: absolute;
	right: 36dp;
	bottom: 36dp;
	gap: 10dp;
	pointer-events: auto;
}

.btn
{
	display: inline-block;
	/* RmlUi 的 <button> 本身不是表单控件，不写 tab-index 就进不了 Tab 序列 */
	tab-index: auto;
	/* 方向键换焦点：nav 必须是按钮自己的本地属性，写在父容器上无效 */
	nav: horizontal;
	padding: 8dp 18dp;
	border-radius: 8dp;
	background-color: rgba(24, 30, 42, 200);
	border: 1dp rgba(255, 255, 255, 60);
	font-size: 15dp;
}

.btn:hover
{
	background-color: rgba(40, 48, 66, 220);
}

/* 圆形按钮：位置在按钮排上方，文字单行居中。它不在 #actions 里，
 * 得自己打开指针，不然 hud 那层的 none 会把它一起关掉 */
#btn-camera
{
	display: block;
	position: absolute;
	right: 16dp;
	bottom: 64dp;
	width: 52dp;
	height: 52dp;
	padding: 0px;
	border-radius: 26dp;
	font-size: 12dp;
	text-align: center;
	line-height: 50dp;
	pointer-events: auto;
}

.btn:active
{
	background-color: rgba(16, 20, 30, 230);
}

.btn:focus
{
	border: 2dp #7f77dd;
}

#stick
{
	display: block;
	position: absolute;
	left: 120dp;
	bottom: 100dp;
	width: 180dp;
	height: 180dp;
	border-radius: 90dp;
	background-color: rgba(12, 16, 24, 120);
	border: 2dp rgba(255, 255, 255, 70);
	pointer-events: auto;
	/* 拖动由 RmlUi 的 drag 属性发起：指针落在底盘任意位置都能拖 */
	drag: drag;
}

#knob
{
	display: block;
	position: absolute;
	left: 50dp;
	top: 50dp;
	width: 80dp;
	height: 80dp;
	border-radius: 40dp;
	background-color: rgba(242, 244, 248, 210);
	border: 2dp rgba(12, 16, 24, 60);
}
