<?xml version='1.0' encoding='UTF-8'?>
<Material ShaderPath="Shaders/MaterialShaders/PBRStandard.glsl">
  <Parameters>
    <ParamInfo Type="0" Name="u_BumpTexture">
      <Texture Path="Models/lps_head/bump.png" Slot="3">
        <LoadConfig IsFlipV="true" IsGenMips="true" SamplerType="0" IsHdr="false" />
      </Texture>
    </ParamInfo>
    <ParamInfo Type="0" Name="u_NormalTexture">
      <Texture Path="Models/lps_head/normal.bmp" Slot="2">
        <LoadConfig IsFlipV="true" IsGenMips="true" SamplerType="0" IsHdr="false" />
      </Texture>
    </ParamInfo>
    <ParamInfo Type="0" Name="u_AlbedoTexture">
      <Texture Path="Models/lps_head/lambertian.jpg" Slot="0">
        <LoadConfig IsFlipV="true" IsGenMips="true" SamplerType="0" IsHdr="false" />
      </Texture>
    </ParamInfo>
  </Parameters>
  <RasterState CullMode="2" FrontFaceType="1" EnableBlend="true" BlendEquationRGB="0" BlendEquationA="0" BlendFuncSrcRGB="1" BlendFuncSrcA="1" BlendFuncDstRGB="0" BlendFuncDstA="0" EnableDepthWrite="true" DepthCompareFunc="1" EnableColorWrite="true" />
</Material>
